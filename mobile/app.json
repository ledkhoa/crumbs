{
  "expo": {
    "name": "Crumbs",
    "slug": "crumbs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crumbs",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kasseling.crumbs",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.kasseling.crumbs"]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Crumbs uses your location to show saved cravings and crumbs near you on the Cravings Map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Crumbs uses your location to show saved cravings and crumbs near you on the Cravings Map."
      }
    },
    "android": {
      "package": "com.kasseling.crumbs",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": {
            "mimeType": "text/plain"
          }
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-share-intent",
        {
          "ios": {
            "AppGroup": "group.com.kasseling.crumbs",
            "shareExtensionVersion": "1.0.0",
            "activationRule": {
              "NSExtensionActivationSupportsText": true,
              "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
              "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
              "NSExtensionActivationSupportsImageWithMaxCount": 1,
              "NSExtensionActivationSupportsMovieWithMaxCount": 1
            }
          },
          "android": {
            "packageNames": [
              "com.instagram.android",
              "com.zhiliaoapp.musically",
              "com.ss.android.ugc.trill"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Crumbs uses your location to show saved cravings and crumbs near you on the Cravings Map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
